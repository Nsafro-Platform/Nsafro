# Copy to .env and adjust for your environment.
DATABASE_URL=postgres://journey_app@127.0.0.1:5433/journey_platform
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional: Google OAuth Web-Client ID (public). Set empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
