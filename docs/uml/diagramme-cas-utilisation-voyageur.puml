@startuml diagramme-cas-utilisation-voyageur
' ============================================================
'  Nsafro — Cas d'utilisation de l'utilisateur inscrit
'  Rendu : plantuml -tpng -tsvg diagramme-cas-utilisation-voyageur.puml
' ============================================================

title <b>Nsafro — Cas d'utilisation du voyageur inscrit</b>

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #F4F9FD
  BorderColor #2C6E9B
  FontSize 14
}

actor "Voyageur\n(utilisateur inscrit)" as Voyageur

rectangle "Espace voyageur" {
  usecase "Se connecter" as UC_Login
  usecase "Se déconnecter" as UC_Logout
  usecase "Consulter son profil" as UC_Profile
  usecase "Consulter les voyages" as UC_Browse
  usecase "Consulter une fiche voyage" as UC_Detail
  usecase "Réserver un voyage" as UC_Book
  usecase "Payer la réservation" as UC_Pay
  usecase "Consulter ses réservations" as UC_History
}

Voyageur --> UC_Login
Voyageur --> UC_Logout
Voyageur --> UC_Profile
Voyageur --> UC_Browse
Voyageur --> UC_Detail
Voyageur --> UC_Book
Voyageur --> UC_Pay
Voyageur --> UC_History

UC_Detail .> UC_Browse : <<extend>>
UC_Book ..> UC_Pay : <<include>>
UC_History ..> UC_Pay : <<extend>>

@enduml
